# ─────────────────────────────────────────────────────────────────────────────
# Bilo Bunker — Environment Variables
#
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# .env is git-ignored; this file (.env.example) is the committed template.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────

# Docker Compose project name
COMPOSE_PROJECT_NAME=bunker

# Port the Node.js HTTP server listens on inside the container.
PORT=3000

# Path to the SQLite database file.
DB_PATH=/data/bunker.db

# Logging verbosity: error | warn | info | debug
LOG_LEVEL=info

# ── Nostr ─────────────────────────────────────────────────────────────────────

# Owner / mode selection — see "Single-User vs Multi-User Mode" in README.md.
#
# OWNER_NSEC: single-user mode. The bunker signs with this key and only this
# key can log in to the dashboard. Accepts nsec1... or 64-char hex.
# Takes precedence over OWNER_PUBKEY. Keep this file private (chmod 600 .env).
OWNER_NSEC=

# OWNER_PUBKEY (alias OWNER_NPUB): multi-user mode admin pubkey.
# Accepts npub1... or 64-char hex. Optional; leave both empty for multi-user
# mode without an owner.
OWNER_PUBKEY=

# Comma-separated list of WebSocket relay URLs the bunker subscribes to.
# Example: DEFAULT_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://nos.lol
DEFAULT_RELAYS=

# ── Domain & Auto-SSL (Caddy / Let's Encrypt) ─────────────────────────────────

# Email address for Let's Encrypt certificate notifications.
CERTBOT_EMAIL=

# Primary domain for Bilo Bunker (e.g. bunker.example.com or localhost).
DOMAIN=localhost

# Optional. Public origin of the dashboard, e.g. https://bunker.example.com.
# Only needed behind a reverse proxy that does not forward the Host and
# X-Forwarded-Proto headers (NIP-98 auth compares against the exact public URL).
PUBLIC_URL=


# Bilo Bunker UI build-time overrides (optional)
#
# By default the dashboard talks to the API on the same origin it is served
# from, which is how the Docker image and Caddy stack are deployed.
# Only set these if you host the API / dashboard / landing page on separate
# domains (the API must then allow CORS and see the public URL for NIP-98).

# Backend API origin, e.g. https://api.example.com
VITE_API_URL=

# Admin dashboard origin, e.g. https://app.example.com
VITE_DASHBOARD_URL=

# Landing page origin, e.g. https://example.com
VITE_LANDING_URL=

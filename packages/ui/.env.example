# Bilo Bunker UI build-time configuration (optional)
#
# By default the dashboard talks to the API on its own origin
# (window.location.origin), which is how the Docker image serves both.
# Only set these if the API and dashboard are on different origins.

# Backend API URL, e.g. https://api.example.com
VITE_API_URL=

# Admin dashboard URL, e.g. https://app.example.com
VITE_DASHBOARD_URL=

# Dev server only: where `pnpm dev` proxies /api (default http://localhost:3000)
VITE_DEV_API_TARGET=

# Bilo Bunker Custom Domain Configuration (Optional for Self-Hosters)
# Leave blank to rely on automatic host resolution

# Target Backend API URL (Default: https://api.bunker-bilo.workouse.com)
VITE_API_URL=https://api.bunker-bilo.workouse.com

# Target Admin Dashboard URL (Default: https://app.bunker-bilo.workouse.com)
VITE_DASHBOARD_URL=https://app.bunker-bilo.workouse.com

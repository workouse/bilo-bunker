# ─────────────────────────────────────────────────────────────────────────────
# Bilo Bunker — Deployment Configuration
#
# Copy this file to deploy.conf and fill in the values.
#   cp deploy.conf.example deploy.conf
#
# deploy.conf is git-ignored; this file (deploy.conf.example) is the committed
# template. Never commit credentials or server addresses to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# SSH host or IP address of the target server.
DEPLOY_HOST=

# SSH login user on the remote server.
DEPLOY_USER=ubuntu

# Path to the local SSH private key used for authentication.
DEPLOY_KEY=~/.ssh/id_rsa

# Absolute path on the remote server where releases are stored.
# Each deploy creates a timestamped subdirectory under releases/ and updates
# the `current` symlink atomically.
DEPLOY_ROOT=/home/ubuntu/bunker

# Number of past releases to keep on the server. Older releases are pruned
# automatically at the end of each successful deploy.
DEPLOY_KEEP_RELEASES=5

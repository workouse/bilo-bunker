# ─────────────────────────────────────────────────────────────────────────────
# Bilo Bunker — Environment Variables Template
#
# Copy this file to .env and fill in the values:
#   cp .env.dist .env
#
# .env is git-ignored; this file (.env.dist) is the committed template.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────

# Docker Compose project name
COMPOSE_PROJECT_NAME=bunker

# Port the Node.js HTTP server listens on inside the container.
PORT=3000

# Path to the SQLite database file.
# In Docker volume mounts: /data/bunker.db
# In local development: ./bunker.db
DB_PATH=/data/bunker.db

# Logging verbosity: error | warn | info | debug
# Per-request NIP-46 logs (method, client pubkey) only appear at debug.
LOG_LEVEL=info

# ── Nostr ─────────────────────────────────────────────────────────────────────

# Operating mode (see README "Operating Modes"):
#
# Multi-user mode (default): leave OWNER_NSEC unset. The bunker generates and
# stores its own signing key, and anyone can log in with a NIP-07 extension.
# OWNER_PUBKEY is optional: the instance admin's public key (npub1... or
# 64-char hex). OWNER_NPUB is an alias and takes precedence.
OWNER_PUBKEY=

# Single-user mode: set OWNER_NSEC to your secret key (nsec1... or 64-char
# hex). The bunker then signs with your key and only you can log in.
# WARNING: anyone who can read this file can read your key; chmod 600 .env.
# WARNING: enabling it replaces the stored bunker key (existing bunker://
# URIs stop working). Back up the database first (make backup).
# OWNER_NSEC=

# Comma-separated list of WebSocket relay URLs the bunker subscribes to.
# Example: DEFAULT_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://nos.lol
DEFAULT_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://nos.lol

# ── Domain & Auto-SSL (Caddy / Let's Encrypt) ─────────────────────────────────

# Email address for Let's Encrypt certificate notifications.
# Example: CERTBOT_EMAIL=z@emre.xyz
CERTBOT_EMAIL=

# Primary domain for Bilo Bunker (e.g. bunker.example.com or localhost).
# Caddy automatically provisions and renews TLS certificates for this domain.
DOMAIN=localhost

# Optional. Public origin of the dashboard, e.g. https://bunker.example.com.
# Only needed behind a reverse proxy that does not forward the Host and
# X-Forwarded-Proto headers (NIP-98 auth compares against the exact public URL).
PUBLIC_URL=

